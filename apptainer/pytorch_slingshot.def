%environment
    export LIBRARY_PATH=/usr/lib64:${LIBRARY_PATH}
    export LD_LIBRARY_PATH=/opt/amazon/ofi-nccl/lib:/usr/lib64:${LD_LIBRARY_PATH}

%post
    set -eu
    rm -rf /opt/amazon
    echo /usr/lib64 > /etc/ld.so.conf.d/efa.conf
    ldconfig
    export LD_LIBRARY_PATH=/usr/lib64:${LD_LIBRARY_PATH}
    export LIBRARY_PATH=/usr/lib64:${LIBRARY_PATH}
    rm -rf /tmp/aws-ofi-nccl
    git clone --branch v1.20.0 https://github.com/aws/aws-ofi-nccl.git /tmp/aws-ofi-nccl
    cd /tmp/aws-ofi-nccl
    ./autogen.sh
    ./configure --prefix=/opt/amazon/ofi-nccl --with-cuda=/usr/local/cuda --with-mpi=/usr/local/mpi --with-hwloc=/usr/local/mpi
    make -j"$(nproc)"
    make install
    rm -rf /usr/local/cuda/compat/lib /usr/local/cuda/compat/.*checked
